---
import { missionQuote, testimonialsData } from '../data/content';
---

<section class="testimonials" data-dark-section>
  <div class="container testimonials__story">
    
    <div class="testimonials__lead" data-reveal>
      <p class="eyebrow">{missionQuote.badge}</p>
      <h2>{missionQuote.headline}</h2>
      
      <div class="testimonials__people">
        <div class="testimonials__avatars">
          <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=160&h=160&q=86" alt="" loading="lazy" />
          <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=160&h=160&q=86" alt="" loading="lazy" />
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=160&h=160&q=86" alt="" loading="lazy" />
          <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=160&h=160&q=86" alt="" loading="lazy" />
          <img src="https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=160&h=160&q=86" alt="" loading="lazy" />
          <img src="https://images.unsplash.com/photo-1531384441138-2736e62e0919?auto=format&fit=crop&w=160&h=160&q=86" alt="" loading="lazy" />
        </div>
        <div class="testimonials__team-note" aria-hidden="true">
          <span>Dedikasi penuh di setiap baris kode aplikasi Anda</span>
          <svg viewBox="0 0 92 70">
            <path d="M83 7C73 31 57 49 15 60M15 60l13-1M15 60l7-11"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="testimonials__copy" data-reveal>
      {missionQuote.description.split('\n\n').map((p) => (
        <p>{p}</p>
      ))}
      <a class="button button--acid" href={missionQuote.ctaLink}>
        <span>{missionQuote.ctaText}</span>
        <i>→</i>
      </a>
    </div>

  </div>

  <div class="testimonials__viewport" aria-label="Testimoni Klien">
    <div class="testimonials__track">
      <div class="testimonials__group" aria-hidden="false">
        {testimonialsData.map((t) => (
          <article>
            <header>
              <img src={t.avatar} alt="" loading="lazy" />
              <span aria-hidden="true">”</span>
            </header>
            <p>{t.quote}</p>
            <footer>
              <b>{t.author}</b>
              <span>{t.role}</span>
            </footer>
          </article>
        ))}
      </div>
      <div class="testimonials__group" aria-hidden="true">
        {testimonialsData.map((t) => (
          <article>
            <header>
              <img src={t.avatar} alt="" loading="lazy" />
              <span aria-hidden="true">”</span>
            </header>
            <p>{t.quote}</p>
            <footer>
              <b>{t.author}</b>
              <span>{t.role}</span>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
