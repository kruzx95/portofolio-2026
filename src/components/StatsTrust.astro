---
import { statsTrustData } from '../data/content';
---

<section class="proof section-pad" data-dark-section>
  <div class="container">
    
    <div class="section-head proof__head" data-reveal>
      <p class="eyebrow">{statsTrustData.badge}</p>
      <h2>{statsTrustData.headline}</h2>
      <p>{statsTrustData.description}</p>
    </div>

    <div class="proof__mosaic">
      <figure data-reveal>
        <img src="https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=900&h=900&q=86" alt="Creative team planning a website launch" loading="lazy" />
      </figure>

      <figure data-reveal>
        <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=900&h=900&q=86" alt="Senior team reviewing work together" loading="lazy" />
      </figure>

      <figure data-reveal>
        <img src="https://images.unsplash.com/photo-1497215842964-222b430dc094?auto=format&fit=crop&w=900&h=900&q=86" alt="Bright independent studio workspace" loading="lazy" />
      </figure>

      <article data-reveal>
        <strong>{statsTrustData.stats[0].value}</strong>
        <h3>{statsTrustData.stats[0].label}</h3>
        <p>{statsTrustData.stats[0].sub}</p>
      </article>

      <article data-reveal>
        <strong>{statsTrustData.stats[1].value}</strong>
        <h3>{statsTrustData.stats[1].label}</h3>
        <p>{statsTrustData.stats[1].sub}</p>
      </article>

      <figure data-reveal>
        <img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=900&h=900&q=86" alt="Project team designing software roadmap" loading="lazy" />
      </figure>

      <figure data-reveal>
        <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=900&h=900&q=86" alt="Consultant presenting software architecture" loading="lazy" />
      </figure>

      <article data-reveal>
        <strong>{statsTrustData.stats[2].value}</strong>
        <h3>{statsTrustData.stats[2].label}</h3>
        <p>{statsTrustData.stats[2].sub}</p>
      </article>

      <article data-reveal>
        <strong>{statsTrustData.stats[3].value}</strong>
        <h3>{statsTrustData.stats[3].label}</h3>
        <p>{statsTrustData.stats[3].sub}</p>
      </article>
    </div>

  </div>
</section>
