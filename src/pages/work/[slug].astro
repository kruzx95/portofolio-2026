        metricLabel: 'digital subscriber growth',
        gallery1: 'https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1500&h=1000&q=86',
        gallery2: 'https://images.unsplash.com/photo-1523726491678-bf852e717f6a?auto=format&fit=crop&w=1500&h=1000&q=86',
        nextSlug: 'common-ground',
        nextName: 'Common Ground',
        nextImage: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1600&h=1100&q=86'
      }
    },
    {
      params: { slug: 'common-ground' },
      props: {
        name: 'Common Ground',
        services: 'Platform Design · Community Portal · Membership System',
        tagline: 'Uniting regional creative communities through a unified web presence.',
        heroImage: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1600&h=1100&q=86',
        storyP1: 'Common Ground grew from 50 to 5,000 members and needed an intuitive hub for event schedules, member directories, and resources.',
        storyP2: 'We delivered a high-speed Astro application connected to automated membership tiers and localized event maps.',
        metric: '10k+',
        metricLabel: 'monthly active members',
        gallery1: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1500&h=1000&q=86',
        gallery2: 'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=1500&h=1000&q=86',
        nextSlug: 'north-house',
        nextName: 'North House',
        nextImage: 'https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1600&h=1100&q=86'
      }
    }
  ];
}

const { 
  name, 
  services, 
  tagline, 
  heroImage, 
  storyP1, 
  storyP2, 
  metric, 
  metricLabel, 
  gallery1, 
  gallery2, 
  nextSlug, 
  nextName, 
  nextImage 
} = Astro.props;
---

<Layout title={`${name} — Project Go Work`}>
  <Navbar />
  <main id="main" class="project-page">
    <section class="project-hero">
      <div class="container project-hero__grid">
        <div class="project-hero__heading" data-reveal>
          <a href="/#work">← All projects</a>
          <p class="eyebrow">Brand strategy · Digital experience</p>
          <h1>{name}</h1>
        </div>
        <div class="project-hero__intro" data-reveal>
          <p>{tagline}</p>
          <dl>
            <div>
              <dt>Year</dt>
              <dd>2026</dd>
            </div>
            <div>
              <dt>Services</dt>
              <dd>{services}</dd>
            </div>
          </dl>
        </div>
      </div>

      <figure class="container project-hero__image" data-reveal>
        <img src={heroImage} alt={`${name} project hero preview`} data-parallax="3" />
        <figcaption>
          <span>Project Go / {name}</span>
          <span>2026</span>
        </figcaption>
      </figure>
    </section>

    <section class="project-story">
      <div class="container project-story__grid">
        <p class="eyebrow" data-reveal>The brief and the shift</p>
        <div class="project-story__copy" data-reveal>
          <p>{storyP1}</p>
          <p>{storyP2}</p>
        </div>
        <aside data-reveal>
          <span>{metric}</span>
          <p>{metricLabel}</p>
        </aside>
      </div>
    </section>

    <section class="project-gallery">
      <div class="container project-gallery__grid">
        <figure data-reveal class="project-gallery__wide">
          <img src={gallery1} alt={`${name} workspace details`} data-parallax="4" loading="lazy" />
        </figure>
        <figure data-reveal>
          <img src={gallery2} alt={`${name} meeting and deliverables`} data-parallax="2" loading="lazy" />
        </figure>
      </div>
    </section>

    <section class="project-outcome">
      <div class="container" data-reveal>
        <p class="eyebrow">The outcome</p>
        <h2>A more confident first impression and a clearer path from project discovery to enquiry.</h2>
        <a class="project-button" href="/contact/">
          <span>Start now</span>
          <i>→</i>
        </a>
      </div>
    </section>

    <a class="next-project" href={`/work/${nextSlug}/`}>
      <img src={nextImage} alt="" loading="lazy" />
      <span class="eyebrow">Next project</span>
      <strong>{nextName}</strong>
      <i>↗</i>
    </a>
  </main>
  <Footer />
</Layout>
