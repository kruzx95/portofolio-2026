---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    slug: "motion-with-a-job",
    number: "01",
    category: "Motion",
    date: "Jun 18, 2026",
    title: "Motion should have a job",
    excerpt: "A practical framework for deciding when movement adds meaning—and when it simply adds noise.",
    readTime: "6 min",
    image: "https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1600&h=1000&q=86",
    alt: "Vivid retro screen showing a colorful moving scene"
  },
  {
    slug: "briefs-that-leave-room",
    number: "02",
    category: "Process",
    date: "May 2, 2026",
    title: "Write a brief that leaves room",
    excerpt: "The best creative briefs create useful constraints without deciding the answer in advance.",
    readTime: "5 min",
    image: "https://images.unsplash.com/photo-1456324504439-367cee3b3c32?auto=format&fit=crop&w=1600&h=1000&q=86",
    alt: "Notebook, pencil, and planning notes on a desk"
  },
  {
    slug: "designing-for-editors",
    number: "03",
    category: "Development",
    date: "Mar 21, 2026",
    title: "Design the CMS for the editor",
    excerpt: "A flexible website is only useful when the people running it understand what the system is asking them to do.",
    readTime: "7 min",
    image: "https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1600&h=1000&q=86",
    alt: "Team arranging content ideas during a workshop"
  }
];
---

<Layout title="Blog — Project Go">
  <Navbar />
  <main id="main" class="journal-page">
    <section class="journal-hero">
      <div class="container journal-hero__grid">
        <div data-reveal>
          <p class="eyebrow">Notes from the studio</p>
          <h1>
            <span>Useful thinking.</span>
            <span>No thought leadership.</span>
          </h1>
        </div>
        <p data-reveal>Clear notes about making websites easier to understand, easier to use, and easier to keep alive after launch.</p>
      </div>
    </section>

    <section class="journal-list">
      <div class="container">
        {posts.map((post) => (
          <a class="journal-card" href={`/blog/${post.slug}/`} aria-label={`Open article: ${post.title}`} data-reveal>
            <span class="journal-card__number">{post.number}</span>
            <figure>
              <img src={post.image} alt={post.alt} loading="lazy" />
            </figure>
            <div>
              <p class="eyebrow">{post.category} · {post.date}</p>
              <h2>{post.title}</h2>
              <p>{post.excerpt}</p>
            </div>
            <aside>
              <span>{post.readTime}</span>
              <i>↗</i>
            </aside>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
