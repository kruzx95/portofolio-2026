---
import { statsTrustData } from '../data/content';
---

<section class="proof section-pad">
  <div class="container">
    
    <div class="section-head proof__head" data-reveal>
      <p class="eyebrow">{statsTrustData.badge}</p>
      <h2>{statsTrustData.headline}</h2>
      <p>{statsTrustData.description}</p>
    </div>

    <div class="proof__mosaic">
      <figure data-reveal>
        <img src="https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=900&h=900&q=86" alt="Creative team planning a website launch" loading="lazy" />
      </figure>

      <figure data-reveal>
        <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=900&h=900&q=86" alt="Senior team reviewing work together" loading="lazy" />
      </figure>

      <figure data-reveal>
        <img src="https://images.unsplash.com/photo-1497215842964-222b430dc094?auto=format&fit=crop&w=900&h=900&q=86" alt="Bright independent studio workspace" loading="lazy" />
      </figure>

      <article data-reveal>
        <strong>12+</strong>
        <h3>years shaping digital work</h3>
        <p>Senior thinking stays close to every detail</p>
      </article>

      <article data-reveal>
        <strong>100+</strong>
        <h3>sites and products launched</h3>
        <p>Each built around a real business problem</p>
      </article>

      <figure data-reveal>
        <img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=900&h=900&q=86" alt="Project team aligning around a launch plan" loading="lazy" />
      </figure>

      <figure data-reveal>
        <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=900&h=900&q=86" alt="Consultant presenting a digital strategy" loading="lazy" />
      </figure>

      <article data-reveal>
        <strong>14</strong>
        <h3>countries reached</h3>
        <p>Remote collaboration, without the distance</p>
      </article>

      <article data-reveal>
        <strong>4.9/5</strong>
        <h3>average client rating</h3>
        <p>Clear communication is part of the deliverable</p>
      </article>
    </div>

  </div>
</section>
