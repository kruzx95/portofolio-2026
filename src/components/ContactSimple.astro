---
import { resolvePath } from '../utils/paths';
---

<section class="contact-section section-pad" id="contact" data-dark-section>
  <div class="container">
    <div class="contact-grid">
      <!-- Left Column: Direct Outreach & Info -->
      <div class="contact-info" data-reveal>
        <span class="contact-badge">TERBUKA UNTUK PELUANG KERJA</span>
        <h2 class="contact-headline">Mari Terhubung &amp;<br />Mulai Diskusi.</h2>
        <p class="contact-intro">
          Terbuka untuk posisi <strong>Web / Frontend Developer</strong> (Full-Time, Kontrak, maupun Remote). 
          Siap berkontribusi dengan keahlian teknis modern dan kemampuan kolaborasi lintas tim.
        </p>

        <!-- Direct Contact Channels -->
        <div class="channels-stack">
          <!-- Email -->
          <a href="mailto:kruza8@gmail.com?subject=Undangan%20Interview%20/%20Diskusi%20Peluang" class="channel-row">
            <div class="row-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="row-body">
              <span class="row-label">EMAIL LANGSUNG</span>
              <strong class="row-val">kruza8@gmail.com</strong>
              <span class="row-desc">Kirim email undangan interview atau tanya jawab teknis</span>
            </div>
            <div class="row-arrow">↗</div>
          </a>

          <!-- WhatsApp -->
          <a href="https://wa.me/6282215739924" target="_blank" rel="noopener noreferrer" class="channel-row">
            <div class="row-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="row-body">
              <span class="row-label">WHATSAPP / TELEPON</span>
              <strong class="row-val">+62 822-1573-9924</strong>
              <span class="row-desc">Respon cepat untuk jadwal wawancara &amp; diskusi langsung</span>
            </div>
            <div class="row-arrow">↗</div>
          </a>

          <!-- LinkedIn -->
          <a href="https://www.linkedin.com/in/mallikwinata" target="_blank" rel="noopener noreferrer" class="channel-row">
            <div class="row-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </div>
            <div class="row-body">
              <span class="row-label">PROFIL LINKEDIN</span>
              <strong class="row-val">linkedin.com/in/mallikwinata</strong>
              <span class="row-desc">Koneksi profesional dan riwayat pengalaman terverifikasi</span>
            </div>
            <div class="row-arrow">↗</div>
          </a>

          <!-- GitHub -->
          <a href="https://github.com/kruzx95" target="_blank" rel="noopener noreferrer" class="channel-row">
            <div class="row-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
            </div>
            <div class="row-body">
              <span class="row-label">GITHUB REPOSITORY</span>
              <strong class="row-val">github.com/kruzx95</strong>
              <span class="row-desc">Koleksi repositori kode, proyek open-source, dan aktivitas koding</span>
            </div>
            <div class="row-arrow">↗</div>
          </a>
        </div>
      </div>

      <!-- Right Column: CV Hub & Quick Message Form -->
      <div class="contact-actions-col" data-reveal>
        <!-- CV Highlight Card -->
        <div class="cv-highlight-card">
          <div class="cv-card-head">
            <span class="cv-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </span>
            <div>
              <span class="cv-sublabel">RESUME &amp; REKAM JEJAK</span>
              <h3 class="cv-card-title">Curriculum Vitae (CV)</h3>
            </div>
          </div>
          <p class="cv-card-desc">
            Dapatkan profil lengkap riwayat pendidikan, pengalaman kerja di instansi, dan rincian keahlian teknis siap review.
          </p>
          <div class="cv-card-btns">
            <a href={resolvePath("/cv/")} class="cv-btn cv-btn-primary">
              <span>Buka Versi Web</span>
              <i>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </i>
            </a>
            <a href={resolvePath("/cv.pdf")} download="cv-2026-Mallik Rushamidiwinata.pdf" class="cv-btn cv-btn-secondary">
              <span>Unduh PDF</span>
              <i>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </i>
            </a>
          </div>
        </div>

        <!-- Quick Direct Note Form -->
        <div class="quick-form-card">
          <h3 class="form-title">Tinggalkan Pesan Singkat</h3>
          <p class="form-subtitle">Atau kirimkan tawaran posisi secara langsung melalui form ini:</p>

          <form class="direct-form" id="directNoteForm" method="post">
            <div class="form-field">
              <label for="direct_name">Nama / Rekruter*</label>
              <input type="text" id="direct_name" name="name" placeholder="Nama Anda / Perusahaan" required />
            </div>

            <div class="form-field">
              <label for="direct_email">Email Kontak*</label>
              <input type="email" id="direct_email" name="email" placeholder="email@perusahaan.com" required />
            </div>

            <div class="form-field">
              <label for="direct_msg">Pesan / Detail Posisi*</label>
              <textarea id="direct_msg" name="message" rows="3" placeholder="Sampaikan tawaran posisi atau pertanyaan..." required></textarea>
            </div>

            <button type="submit" class="button button--acid form-submit-btn">
              <span>Kirim Pesan via Email</span>
              <i>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </i>
            </button>
            <p class="form-status" id="directFormStatus" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background: #171714;
    color: var(--paper, #f6f6f2);
    padding: clamp(5rem, 8vw, 8rem) 0;
    border-top: 1px solid #2a2a26;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* Left Column */
  .contact-badge {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.74rem;
    font-weight: 750;
    color: var(--ink, #171714);
    background: var(--acid, #c8ff46);
    padding: 0.25rem 0.65rem;
    border-radius: 0.35rem;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .contact-headline {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: #ffffff;
    margin: 0 0 1.25rem;
  }

  .contact-intro {
    font-size: 1.02rem;
    line-height: 1.65;
    color: #b5b5ad;
    margin: 0 0 2.25rem;
    max-width: 48ch;
  }

  .contact-intro strong {
    color: #ffffff;
  }

  /* Channels Stack */
  .channels-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .channel-row {
    background: #20201d;
    border: 1.5px solid #363630;
    border-radius: 0.85rem;
    padding: 1.25rem 1.4rem;
    display: flex;
    align-items: center;
    gap: 1.15rem;
    color: var(--paper, #f6f6f2);
    text-decoration: none;
    transition: transform 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }

  .channel-row:hover {
    background: #272723;
    border-color: var(--acid, #c8ff46);
    transform: translateX(4px);
  }

  .row-icon {
    width: 2.75rem;
    height: 2.75rem;
    background: #2a2a26;
    border: 1px solid #44443e;
    border-radius: 0.55rem;
    display: grid;
    place-items: center;
    color: var(--acid, #c8ff46);
    flex-shrink: 0;
    transition: all 0.25s ease;
  }

  .channel-row:hover .row-icon {
    background: var(--acid, #c8ff46);
    color: var(--ink, #171714);
  }

  .row-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex-grow: 1;
    min-width: 0;
  }

  .row-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    color: #8c8c85;
  }

  .row-val {
    font-size: 1.05rem;
    font-weight: 750;
    color: #ffffff;
  }

  .row-desc {
    font-size: 0.8rem;
    color: #9c9c94;
    line-height: 1.35;
  }

  .row-arrow {
    font-size: 1.3rem;
    color: #666660;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .channel-row:hover .row-arrow {
    color: var(--acid, #c8ff46);
    transform: translate(2px, -2px);
  }

  /* Right Column */
  .contact-actions-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* CV Highlight Card */
  .cv-highlight-card {
    background: #22221f;
    border: 2px solid var(--acid, #c8ff46);
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .cv-card-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }

  .cv-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--acid, #c8ff46);
  }

  .cv-btn i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-style: normal;
  }

  .cv-sublabel {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    color: var(--acid, #c8ff46);
    display: block;
  }

  .cv-card-title {
    font-size: 1.25rem;
    font-weight: 850;
    color: #ffffff;
    margin: 0;
  }

  .cv-card-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #cfcfc7;
    margin: 0 0 1.35rem;
  }

  .cv-card-btns {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.84rem;
    font-weight: 750;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .cv-btn-primary {
    background: var(--acid, #c8ff46);
    color: var(--ink, #171714);
  }

  .cv-btn-secondary {
    background: #2f2f2b;
    color: #ffffff;
    border: 1px solid #4a4a42;
  }

  .cv-btn:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  /* Quick Form Card */
  .quick-form-card {
    background: #20201d;
    border: 1.5px solid #363630;
    border-radius: 1rem;
    padding: 1.75rem;
  }

  .form-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.35rem;
  }

  .form-subtitle {
    font-size: 0.84rem;
    color: #9c9c94;
    margin: 0 0 1.25rem;
  }

  .direct-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-field label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #d0d0c8;
  }

  .form-field input,
  .form-field textarea {
    background: #282824;
    border: 1px solid #45453f;
    border-radius: 0.5rem;
    padding: 0.8rem 1rem;
    color: #ffffff;
    font-family: inherit;
    font-size: 16px; /* Prevents auto-zoom on iOS Safari */
    transition: border-color 0.2s ease;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--acid, #c8ff46);
    background: #2d2d28;
  }

  .form-field textarea {
    resize: vertical;
  }

  .form-submit-btn {
    width: 100%;
    margin-top: 0.35rem;
  }

  .form-status {
    text-align: center;
    color: var(--acid, #c8ff46);
    font-size: 0.82rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-headline {
      font-size: clamp(1.85rem, 7vw, 2.2rem);
    }
  }

  @media (max-width: 640px) {
    .channel-row {
      padding: 1rem 1.1rem;
      gap: 0.85rem;
    }

    .row-val {
      word-break: break-all;
    }

    .cv-card-btns {
      flex-direction: column;
    }

    .cv-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const directForm = document.getElementById('directNoteForm') as HTMLFormElement | null;
  const directStatus = document.getElementById('directFormStatus');

  if (directForm) {
    directForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(directForm);
      const name = fd.get('name') || '';
      const email = fd.get('email') || '';
      const message = fd.get('message') || '';

      const subject = encodeURIComponent(`Undangan / Pesan Rekruter dari ${name}`);
      const body = encodeURIComponent(`Nama / Rekruter: ${name}\nEmail: ${email}\n\nPesan:\n${message}`);

      if (directStatus) {
        directStatus.textContent = 'Membuka aplikasi email...';
      }

      window.location.href = `mailto:kruza8@gmail.com?subject=${subject}&body=${body}`;

      setTimeout(() => {
        if (directStatus) {
          directStatus.textContent = 'Jika aplikasi email belum terbuka, silakan kirim langsung ke kruza8@gmail.com';
        }
      }, 1500);
    });
  }
</script>
