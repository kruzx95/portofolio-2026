---
import { impactData } from '../data/content';
---

<section class="impact section-pad" id="initiative">
  <div class="container impact__layout">
    <div class="impact__copy" data-reveal>
      <p class="eyebrow">{impactData.badge}</p>
      <h2>{impactData.headline}</h2>
      <p>{impactData.description}</p>
      <a class="button button--dark" href="/initiative/">
        <span>{impactData.ctaText}</span>
        <i>→</i>
      </a>
    </div>

    <div class="impact__images">
      <figure class="impact-image impact-image--1" data-parallax="9">
        <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=700&h=800&q=86" alt="Community volunteers working together" loading="lazy" />
      </figure>

      <figure class="impact-image impact-image--2" data-parallax="5">
        <img src="https://images.unsplash.com/photo-1559027615-cd4628902d4a?auto=format&fit=crop&w=700&h=800&q=86" alt="Community workshop participants smiling" loading="lazy" />
      </figure>

      <figure class="impact-image impact-image--3" data-parallax="9">
        <img src="https://images.unsplash.com/photo-1593113598332-cd288d649433?auto=format&fit=crop&w=700&h=800&q=86" alt="Volunteers preparing materials" loading="lazy" />
      </figure>
    </div>
  </div>
</section>
