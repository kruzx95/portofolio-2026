---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { resolvePath } from '../utils/paths';

const cvData = {
  name: "MALLIK RUSHAMIDIWINATA",
  title: "Web Developer",
  subTitle: "Frontend & WordPress Specialist",
  location: "Tasikmalaya, Indonesia",
  phone: "+6282215739924",
  phoneFormatted: "+62 822-1573-9924",
  email: "kruza8@gmail.com",
  linkedin: "linkedin.com/in/malliknata",
  linkedinUrl: "https://www.linkedin.com/in/malliknata",
  portfolio: "mallik-winata.vercel.app",
  portfolioUrl: "https://mallik-winata.vercel.app",
  summary: "Web Developer dengan pengalaman dalam membangun dan mengembangkan website instansi pemerintahan. Menguasai WordPress serta teknologi modern seperti TypeScript dan Tailwind CSS untuk menghasilkan aplikasi yang responsif dan efisien. Memiliki kemampuan kolaborasi lintas tim serta adaptasi tinggi yang didukung oleh pengalaman di bidang Human Resources.",
  experiences: [
    {
      company: "Diskominfo Kota Tasikmalaya",
      type: "Onsite",
      role: "Frontend Developer",
      period: "Januari 2024 – Sekarang",
      current: true,
      points: [
        "Mengembangkan website untuk berbagai instansi menggunakan WordPress sebagai solusi awal kebutuhan digitalisasi.",
        "Dipercaya untuk membangun ulang website resmi Diskominfo Kota Tasikmalaya dari awal guna meningkatkan performa dan pengalaman pengguna.",
        "Mengimplementasikan teknologi modern seperti TypeScript dan Tailwind CSS dalam pengembangan website.",
        "Berkolaborasi dengan tim internal untuk memastikan kebutuhan sistem sesuai dengan kebutuhan instansi."
      ],
      tags: ["TypeScript", "Tailwind CSS", "WordPress", "Government Web", "UI/UX"]
    },
    {
      company: "Kimia Farma Diagnostika Jakarta",
      type: "Onsite",
      role: "Human Resources & IT Support",
      period: "2020 (1 Tahun)",
      current: false,
      points: [
        "Mengelola dan memperbarui data karyawan di beberapa cabang untuk memastikan akurasi dan kelengkapan administrasi HR.",
        "Berkolaborasi dengan tim terkait dalam proses penyusunan laporan penggajian karyawan secara berkala.",
        "Memberikan dukungan teknis (IT Support) dalam menangani kendala perangkat keras dan jaringan internet di lingkungan kerja.",
        "Membantu memastikan kelancaran operasional melalui koordinasi lintas divisi."
      ],
      tags: ["HR Administration", "IT Support", "Troubleshooting", "Payroll Reporting"]
    }
  ],
  education: [
    {
      institution: "Universitas Komputer Indonesia (UNIKOM)",
      major: "Sistem Informasi / Information System",
      degree: "Sarjana Komputer (S.Kom.)",
      gpa: "3.09",
      period: "2014 – 2019",
      notes: "Berkolaborasi dengan tim administrasi untuk mengidentifikasi kebutuhan alur kerja, kemudian mengimplementasikannya ke dalam sistem SPJ berbasis web guna memastikan transparansi data keuangan. (Diskominfo Kota Bandung 2017)"
    }
  ],
  skills: {
    frontend: ["TypeScript", "HTML5", "CSS3", "Tailwind CSS", "WordPress"],
    database: ["MySQL"],
    tools: ["Git", "GitHub", "Troubleshoot Computer & Jaringan"],
    soft: ["Kolaborasi Lintas Tim", "Komunikasi & HR Administration", "Problem Solving"]
  },
  languages: [
    { name: "Indonesia", level: "Native" },
    { name: "English", level: "Conversation (TOEFL 490) 2022" }
  ]
};
---

<Layout 
  title={`${cvData.name} — Curriculum Vitae (Web Version)`} 
  description={`CV & Resume profesional Mallik Rushamidiwinata — ${cvData.title} dengan pengalaman TypeScript, Tailwind CSS, WordPress, dan Sistem Informasi.`}
>
  <div class="no-print">
    <Navbar />
  </div>

  <main class="cv-page">
    <div class="container cv-container">
      <!-- Toolbar / Action Bar (Non-print) -->
      <div class="cv-toolbar no-print">
        <a href={resolvePath("/")} class="toolbar-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Kembali ke Portofolio</span>
        </a>

        <div class="toolbar-actions">
          <button type="button" class="btn-action btn-print" onclick="window.print()" title="Cetak atau simpan sebagai PDF">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            <span>Cetak / Save PDF</span>
          </button>

          <a href={resolvePath("/cv.pdf")} download="MALLIK_RUSHAMIDIWINATA_CV.pdf" class="btn-action btn-download" title="Unduh file PDF asli">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Unduh PDF Asli</span>
          </a>
        </div>
      </div>

      <!-- Main CV Paper Card -->
      <article class="cv-paper">
        <!-- Header Profil -->
        <header class="cv-header">
          <div class="header-main">
            <div class="name-block">
              <span class="badge-role">{cvData.title}</span>
              <h1 class="cv-name">{cvData.name}</h1>
              <p class="cv-role-subtitle">{cvData.subTitle}</p>
            </div>
            
            <div class="location-badge">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>{cvData.location}</span>
            </div>
          </div>

          <!-- Quick Contacts Grid -->
          <div class="cv-contacts-grid">
            <a href={`https://wa.me/${cvData.phone.replace('+', '')}`} target="_blank" rel="noopener noreferrer" class="contact-pill" title="WhatsApp / Telepon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>{cvData.phoneFormatted}</span>
            </a>

            <a href={`mailto:${cvData.email}`} class="contact-pill" title="Kirim Email">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>{cvData.email}</span>
            </a>

            <a href={cvData.linkedinUrl} target="_blank" rel="noopener noreferrer" class="contact-pill" title="Profil LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              <span>{cvData.linkedin}</span>
            </a>

            <a href={cvData.portfolioUrl} target="_blank" rel="noopener noreferrer" class="contact-pill" title="Website Portofolio">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span>{cvData.portfolio}</span>
            </a>
          </div>
        </header>

        <!-- Body Layout -->
        <div class="cv-layout">
          <!-- Main Column -->
          <div class="cv-main-column">
            <!-- Summary -->
            <section class="cv-section">
              <div class="section-title-wrap">
                <h2 class="section-title">Summary</h2>
                <div class="section-line"></div>
              </div>
              <p class="summary-text">{cvData.summary}</p>
            </section>

            <!-- Professional Experience -->
            <section class="cv-section">
              <div class="section-title-wrap">
                <h2 class="section-title">Profesional Experience</h2>
                <div class="section-line"></div>
              </div>

              <div class="timeline-list">
                {cvData.experiences.map((exp) => (
                  <div class="timeline-item">
                    <div class="timeline-header">
                      <div>
                        <h3 class="company-name">{exp.company} <span class="work-type">({exp.type})</span></h3>
                        <p class="role-title">{exp.role}</p>
                      </div>
                      <div class="period-badge">{exp.period}</div>
                    </div>
                    
                    <ul class="points-list">
                      {exp.points.map((pt) => (
                        <li>{pt}</li>
                      ))}
                    </ul>

                    {exp.tags && (
                      <div class="tag-row no-print">
                        {exp.tags.map((tg) => (
                          <span class="skill-tag">{tg}</span>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </section>

            <!-- Education -->
            <section class="cv-section">
              <div class="section-title-wrap">
                <h2 class="section-title">Education</h2>
                <div class="section-line"></div>
              </div>

              {cvData.education.map((edu) => (
                <div class="timeline-item edu-item">
                  <div class="timeline-header">
                    <div>
                      <h3 class="company-name">{edu.institution}</h3>
                      <p class="role-title">{edu.degree} — {edu.major} <span class="gpa-badge">GPA {edu.gpa}</span></p>
                    </div>
                    <div class="period-badge">{edu.period}</div>
                  </div>
                  
                  <ul class="points-list">
                    <li>{edu.notes}</li>
                  </ul>
                </div>
              ))}
            </section>
          </div>

          <!-- Side Column -->
          <aside class="cv-side-column">
            <!-- Technical Skills -->
            <section class="cv-section">
              <div class="section-title-wrap">
                <h2 class="section-title">Technical Skills</h2>
                <div class="section-line"></div>
              </div>

              <div class="skills-group">
                <h4 class="skills-group-title">Languages & Frontend</h4>
                <div class="pill-cloud">
                  {cvData.skills.frontend.map((s) => (
                    <span class="skill-pill highlight">{s}</span>
                  ))}
                </div>
              </div>

              <div class="skills-group">
                <h4 class="skills-group-title">Database</h4>
                <div class="pill-cloud">
                  {cvData.skills.database.map((s) => (
                    <span class="skill-pill">{s}</span>
                  ))}
                </div>
              </div>

              <div class="skills-group">
                <h4 class="skills-group-title">Tools & Systems</h4>
                <div class="pill-cloud">
                  {cvData.skills.tools.map((s) => (
                    <span class="skill-pill">{s}</span>
                  ))}
                </div>
              </div>
            </section>

            <!-- Languages -->
            <section class="cv-section">
              <div class="section-title-wrap">
                <h2 class="section-title">Languages</h2>
                <div class="section-line"></div>
              </div>

              <div class="lang-list">
                {cvData.languages.map((l) => (
                  <div class="lang-item">
                    <span class="lang-name">{l.name}</span>
                    <span class="lang-level">{l.level}</span>
                  </div>
                ))}
              </div>
            </section>

            <!-- Quick Direct Contacts / Connect Box -->
            <section class="cv-section no-print contact-box-section">
              <div class="connect-card">
                <h4 class="connect-title">Tertarik Berkolaborasi?</h4>
                <p class="connect-desc">Terbuka untuk diskusi proyek web, full-stack, maupun peluang karir profesional.</p>
                <div class="connect-btns">
                  <a href={`https://wa.me/${cvData.phone.replace('+', '')}`} target="_blank" rel="noopener noreferrer" class="btn-connect btn-connect-wa">
                    <span>Chat WhatsApp</span>
                    <i>→</i>
                  </a>
                  <a href={`mailto:${cvData.email}`} class="btn-connect btn-connect-mail">
                    <span>Kirim Email</span>
                    <i>✉</i>
                  </a>
                </div>
              </div>
            </section>
          </aside>
        </div>
      </article>
    </div>
  </main>

  <div class="no-print">
    <Footer />
  </div>
</Layout>

<style>
  /* =========================================
     PAGE STYLING & BASE LAYOUT
     ========================================= */
  .cv-page {
    background: var(--paper, #f6f6f2);
    min-height: 100vh;
    padding: 7.5rem 1rem 5rem;
    color: var(--ink, #171714);
  }

  .cv-container {
    max-width: 980px;
    margin: 0 auto;
  }

  /* =========================================
     TOOLBAR (Back & Print/Download buttons)
     ========================================= */
  .cv-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .toolbar-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink, #171714);
    background: rgba(23, 23, 20, 0.05);
    border: 1px solid rgba(23, 23, 20, 0.12);
    padding: 0.55rem 1rem;
    border-radius: 0.55rem;
    transition: all 0.2s ease;
  }

  .toolbar-link:hover {
    background: var(--ink, #171714);
    color: var(--paper, #f6f6f2);
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 750;
    padding: 0.55rem 1.1rem;
    border-radius: 0.55rem;
    cursor: pointer;
    border: 1.5px solid var(--ink, #171714);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
  }

  .btn-print {
    background: var(--paper, #f6f6f2);
    color: var(--ink, #171714);
    box-shadow: 2px 3px 0 var(--ink, #171714);
  }

  .btn-print:hover {
    box-shadow: 1px 1px 0 var(--ink, #171714);
    transform: translate(1px, 1px);
    background: #ffffff;
  }

  .btn-download {
    background: var(--accent, #c8ff46);
    color: var(--accent-text, #171714);
    box-shadow: 2px 3px 0 var(--ink, #171714);
  }

  .btn-download:hover {
    box-shadow: 1px 1px 0 var(--ink, #171714);
    transform: translate(1px, 1px);
  }

  /* =========================================
     CV PAPER SHEET
     ========================================= */
  .cv-paper {
    background: #ffffff;
    border: 2px solid var(--ink, #171714);
    border-radius: 1rem;
    box-shadow: 6px 8px 0 var(--ink, #171714);
    padding: clamp(2rem, 4vw, 3.5rem);
    position: relative;
    overflow: hidden;
  }

  /* Header */
  .cv-header {
    border-bottom: 2px solid #e8e8e2;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .header-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .name-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .badge-role {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 750;
    text-transform: uppercase;
    background: var(--accent, #c8ff46);
    color: var(--accent-text, #171714);
    padding: 0.25rem 0.65rem;
    border-radius: 0.35rem;
    border: 1px solid rgba(23, 23, 20, 0.15);
  }

  .cv-name {
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #111111;
    margin: 0.2rem 0 0;
  }

  .cv-role-subtitle {
    font-size: 1.05rem;
    font-weight: 650;
    color: #555550;
    margin: 0;
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #f4f4ef;
    padding: 0.45rem 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #444440;
    border: 1px solid #e2e2dc;
  }

  /* Contacts Grid */
  .cv-contacts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0.65rem;
  }

  .contact-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #fafaf7;
    border: 1px solid #e5e5de;
    padding: 0.6rem 0.9rem;
    border-radius: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #222220;
    transition: all 0.2s ease;
    text-decoration: none;
    word-break: break-all;
  }

  .contact-pill svg {
    flex-shrink: 0;
    color: #666660;
    transition: color 0.2s ease;
  }

  .contact-pill:hover {
    background: #ffffff;
    border-color: var(--ink, #171714);
    color: #000000;
    box-shadow: 2px 2px 0 rgba(23, 23, 20, 0.1);
  }

  .contact-pill:hover svg {
    color: var(--ink, #171714);
  }

  /* Two Column Layout */
  .cv-layout {
    display: grid;
    grid-template-columns: 1.75fr 1fr;
    gap: clamp(2rem, 3.5vw, 3rem);
    align-items: start;
  }

  /* Section Titles */
  .cv-section {
    margin-bottom: 2.2rem;
  }

  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.15rem;
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #111110;
    margin: 0;
    white-space: nowrap;
  }

  .section-line {
    flex-grow: 1;
    height: 1.5px;
    background: #e8e8e2;
  }

  .summary-text {
    font-size: 0.94rem;
    line-height: 1.68;
    color: #383834;
    text-align: justify;
  }

  /* Timeline & Work Experience */
  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .timeline-item {
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed #e8e8e0;
  }

  .timeline-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }

  .company-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: #111111;
    margin: 0;
  }

  .work-type {
    font-size: 0.82rem;
    font-weight: 600;
    color: #666660;
  }

  .role-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #4a4a45;
    margin: 0.2rem 0 0;
  }

  .period-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.74rem;
    font-weight: 650;
    background: #f0f0ea;
    color: #333330;
    padding: 0.22rem 0.6rem;
    border-radius: 0.35rem;
    border: 1px solid #dfdfd7;
    white-space: nowrap;
  }

  .points-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .points-list li {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #333330;
    position: relative;
    padding-left: 1.25rem;
  }

  .points-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
    font-size: 1.15rem;
    line-height: 1.2;
    color: #111111;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.85rem;
  }

  .skill-tag {
    font-size: 0.72rem;
    font-weight: 650;
    background: #f4f4ee;
    color: #444440;
    padding: 0.18rem 0.5rem;
    border-radius: 0.3rem;
    border: 1px solid #e0e0d6;
  }

  /* Education specifics */
  .edu-item .gpa-badge {
    display: inline-block;
    background: #e9f5e1;
    color: #245814;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 0.25rem;
    border: 1px solid #c2e2b3;
    margin-left: 0.4rem;
  }

  /* Side Column Skills */
  .skills-group {
    margin-bottom: 1.15rem;
  }

