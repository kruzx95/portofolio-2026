---
import { comparisonData } from '../data/content';
---

<section class="comparison section-pad" id="why-us">
  <div class="container">
    
    <div class="section-head centered" data-reveal>
      <p class="eyebrow">{comparisonData.badge}</p>
      <h2>{comparisonData.headline}</h2>
      <p>{comparisonData.description}</p>
      <em>It should feel like progress, not project management. ↙</em>
    </div>

    <div class="comparison__scroller">
      <div class="comparison__table" data-reveal>
        
        <div class="comparison__labels">
          <span></span>
          <b>Timeline</b>
          <b>Price</b>
          <b>Custom design</b>
          <b>Copy + build</b>
          <b>Guarantee</b>
        </div>

        <div class="comparison__column featured">
          <strong>Project Go</strong>
          <span><i>✓</i>4–6 weeks</span>
          <span><i>✓</i>One clear price</span>
          <span><i>✓</i>Always custom</span>
          <span><i>✓</i>Copy + build included</span>
          <span><i>✓</i>Launch guarantee</span>
        </div>

        <div class="comparison__column">
          <strong>Agency</strong>
          <span><i>×</i>3–6+ months</span>
          <span><i>×</i>Large deposit</span>
          <span><i>×</i>Usually custom</span>
          <span><i>×</i>Often extra</span>
          <span><i>×</i>Rarely</span>
        </div>

        <div class="comparison__column">
          <strong>Freelancer</strong>
          <span><i>×</i>4–12 weeks</span>
          <span><i>×</i>Variable quote</span>
          <span><i>×</i>Depends who you hire</span>
          <span><i>×</i>Rarely included</span>
          <span><i>×</i>Rarely</span>
        </div>

        <div class="comparison__column">
          <strong>DIY</strong>
          <span><i>×</i>When time appears</span>
          <span><i>×</i>Your time</span>
          <span><i>×</i>Template-led</span>
          <span><i>×</i>All on you</span>
          <span><i>×</i>No refund on time</span>
        </div>

      </div>
    </div>

    <div class="comparison__cta">
      <p>Ready for a clearer way to launch?</p>
      <a class="button button--acid" href="/contact/">
        <span>Choose the clearer path</span>
        <i>→</i>
      </a>
    </div>

  </div>
</section>
