---
import { siteMeta } from '../data/content';
import { resolvePath } from '../utils/paths';
---

<header class="site-header" data-site-header>
  <a class="wordmark" href={resolvePath("/")} aria-label="Mallik Studio home">
    <span>Mallik</span><strong>Dev</strong>
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    <a href={resolvePath("/#experience")}><span>Pengalaman</span></a>
    <a href={resolvePath("/#skills")}><span>Keahlian</span></a>
    <a href={resolvePath("/cv/")}><span>CV</span></a>
    <a href={resolvePath("/#contact")}><span>Kontak</span></a>
  </nav>

  <a class="header-cta" href={resolvePath("/cv/")}>
    <span>Buka CV</span><i>→</i>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" id="mobileToggleBtn">
    <span></span>
    <span></span>
  </button>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <a href={resolvePath("/#experience")}><small>01</small><span>Pengalaman Kerja</span><i>↗</i></a>
      <a href={resolvePath("/#skills")}><small>02</small><span>Keahlian Teknis</span><i>↗</i></a>
      <a href={resolvePath("/cv/")}><small>03</small><span>Curriculum Vitae</span><i>↗</i></a>
      <a href={resolvePath("/#contact")}><small>04</small><span>Hubungi Saya</span><i>↗</i></a>
      <a class="mobile-menu__cta" href={resolvePath("/cv/")}><span>Lihat CV Lengkap</span><i>→</i></a>
    </nav>
  </div>
</header>

<style>
  /* Base transitions for adaptive header */
  .site-header {
    transition: color 0.3s ease, background 0.3s ease;
  }
  
  .wordmark {
    transition: color 0.3s ease;
  }

  .wordmark strong {
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .desktop-nav,
  .header-cta {
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }

  /* When over dark sections */
  :global(.site-header.is-dark) .wordmark {
    color: var(--paper, #f6f6f2);
  }

  :global(.site-header.is-dark) .wordmark strong {
    background: var(--acid, #c8ff46);
    color: var(--ink, #171714);
  }

  :global(.site-header.is-dark) .desktop-nav {
    background: #252522;
    border: 1px solid #44443e;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  :global(.site-header.is-dark) .header-cta {
    background: #252522;
    border: 1px solid #44443e;
    color: var(--paper, #f6f6f2);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  :global(.site-header.is-dark) .menu-toggle span {
    background: var(--paper, #f6f6f2);
  }

  @media (max-width: 760px) {
    :global(.site-header.is-dark) {
      background: rgba(23, 23, 20, 0.92);
      color: var(--paper, #f6f6f2);
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobileToggleBtn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    const closeMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('menu-open');
    };

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.setAttribute('aria-hidden', String(isExpanded));
      document.body.classList.toggle('menu-open', !isExpanded);
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  }

  // Real-time automatic light/dark theme detector for fixed header
  const updateHeaderTheme = () => {
    const header = document.querySelector('[data-site-header]');
    if (!header) return;

    const headerRect = header.getBoundingClientRect();
    const headerMidY = headerRect.top + headerRect.height / 2;

    const darkElements = document.querySelectorAll(
      '[data-dark-section], .work, .proof, .testimonials, .contact, .footer, .contact-page, .project-page'
    );

    let isOverDark = false;
    darkElements.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top <= headerMidY && rect.bottom >= headerMidY) {
        isOverDark = true;
      }
    });

    if (isOverDark) {
      header.classList.add('is-dark');
    } else {
      header.classList.remove('is-dark');
    }
  };

  window.addEventListener('scroll', updateHeaderTheme, { passive: true });
  window.addEventListener('resize', updateHeaderTheme, { passive: true });
  document.addEventListener('astro:page-load', updateHeaderTheme);
  document.addEventListener('DOMContentLoaded', updateHeaderTheme);
  updateHeaderTheme();
</script>
