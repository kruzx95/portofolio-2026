    background: #33332e;
    color: #ffffff;
  }

  @media (max-width: 680px) {
    .project-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .project-item {
      padding: 1.5rem;
    }

