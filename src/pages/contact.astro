---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { contactData } from '../data/content';
---

<Layout title="Kontak Mallik Rushamidiwinata — Web & Frontend Developer">
  <Navbar />
  <main id="main" class="contact-page" data-dark-section>
    <section class="contact-page__hero">
      <div class="container contact-page__grid">
        <div data-reveal>
          <p class="eyebrow">Terbuka untuk Peluang Kerja &amp; Kolaborasi</p>
          <h1>
            <span>Mari Terhubung &amp;</span>
            <span>Bekerja Sama.</span>
          </h1>
        </div>
        <div class="contact-page__intro" data-reveal>
          <p>Terbuka untuk mendiskusikan peluang karir, posisi web development, maupun kolaborasi proyek sistem informasi. Saya siap memberikan kontribusi terbaik.</p>
          <span>Email &amp; WhatsApp aktif setiap hari</span>
        </div>
      </div>
    </section>

    <section class="contact-page__body">
      <div class="container contact-page__body-grid">
        <aside data-reveal>
          <p class="eyebrow">Kontak Langsung</p>
          <a href="mailto:kruza8@gmail.com?subject=Undangan%20Interview%20/%20Diskusi%20Peluang">kruza8@gmail.com</a>
          <a href="https://wa.me/6282215739924" target="_blank" rel="noopener" class="gmail-direct-btn">WhatsApp: +62 822-1573-9924 ↗</a>
          <a href="https://linkedin.com/in/malliknata" target="_blank" rel="noopener" class="gmail-direct-btn">LinkedIn: /in/malliknata ↗</a>
          <p>Web Developer · Tasikmalaya &amp; Remote</p>
        </aside>

        <div data-reveal>
          <form class="contact__form" id="pageContactForm" method="post">
            <label>
              <span>Nama Lengkap</span>
              <input type="text" name="name" id="page_name" placeholder={contactData.form.namePlaceholder} required autocomplete="name" />
            </label>
            <label>
              <span>Alamat Email</span>
              <input type="email" name="email" id="page_email" placeholder={contactData.form.emailPlaceholder} required autocomplete="email" />
            </label>
            <label>
              <span>Perusahaan / Bisnis</span>
              <input type="text" name="company" id="page_company" placeholder={contactData.form.companyPlaceholder} required autocomplete="organization" />
            </label>
            <label>
              <span>Target Peluncuran</span>
              <input type="text" name="timeline" id="page_timeline" placeholder={contactData.form.timelinePlaceholder} />
            </label>
            <label class="full">
              <span>Detail Kebutuhan Aplikasi</span>
              <textarea name="message" id="page_message" placeholder={contactData.form.messagePlaceholder} required rows="5"></textarea>
            </label>
            <button class="button button--acid" type="submit">
              <span>Kirim Pesan via Email / Gmail</span>
              <i>→</i>
            </button>
            <p class="form-status" id="pageFormStatus" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .contact-page {
    background: var(--ink);
    color: var(--paper);
    min-height: 100vh;
    padding-top: 4rem;
  }
  .contact-page__hero {
    padding: 6rem 0 3rem;
  }
  .contact-page__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: end;
  }
  .contact-page__grid h1 {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 850;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-top: 1rem;
  }
  .contact-page__grid h1 span {
    display: block;
  }
  .contact-page__intro p {
    font-size: 1.15rem;
    line-height: 1.5;
    color: #b0b0a8;
  }
  .contact-page__intro span {
    display: block;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--acid);
    font-family: var(--font-mono);
  }
  .contact-page__body {
    padding: 4rem 0 8rem;
    border-top: 1px solid #2a2a26;
  }
  .contact-page__body-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4rem;
  }
  .contact-page aside {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .contact-page aside a {
    color: var(--paper);
    font-size: 1.1rem;
    font-weight: 700;
  }
  .contact-page aside a:hover {
    color: var(--acid);
    text-decoration: underline;
  }
  .contact-page aside .gmail-direct-btn {
    color: var(--acid);
    font-size: 0.92rem;
    font-weight: 700;
  }
  .contact-page aside p {
    color: #888880;
    font-size: 0.9rem;
  }
  @media (max-width: 768px) {
    .contact-page__grid,
    .contact-page__body-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

<script>
  const form = document.getElementById('pageContactForm') as HTMLFormElement;
  const status = document.getElementById('pageFormStatus');

  if (form && status) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = (formData.get('name') as string) || '';
      const email = (formData.get('email') as string) || '';
      const company = (formData.get('company') as string) || '-';
      const timeline = (formData.get('timeline') as string) || '-';
      const message = (formData.get('message') as string) || '';

      const subject = `[Konsultasi Proyek] Jasa Pembuatan Aplikasi - ${name}`;
      const body = `Halo Mallik,\n\nSaya ingin berkonsultasi mengenai proyek aplikasi:\n\n- Nama: ${name}\n- Email: ${email}\n- Perusahaan / Bisnis: ${company}\n- Target Peluncuran: ${timeline}\n\nKebutuhan & Detail Aplikasi:\n${message}\n\nTerima kasih.`;

      const mailtoUrl = `mailto:kruza8@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      
      status.textContent = 'Membuka aplikasi email/Gmail untuk Anda... Silakan klik Kirim pada email Anda.';
      
      window.location.href = mailtoUrl;
    });
  }
</script>
