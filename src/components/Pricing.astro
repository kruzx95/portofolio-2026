---
import { pricingData } from '../data/content';
---

<section class="pricing section-pad" id="pricing">
  <div class="container">
    
    <div class="section-head centered" data-reveal>
      <p class="eyebrow">{pricingData.badge}</p>
      <h2>{pricingData.headline}</h2>
      <p>{pricingData.description}</p>
    </div>

    <div class="pricing__grid">
      
      <!-- Main Offer -->
      <article class="price-card price-card--main" data-reveal>
        <div class="price-card__offer">
          <span class="label">{pricingData.mainPlan.tag}</span>
          <div class="plan-header">
            <h3>{pricingData.mainPlan.title}</h3>
            <p class="plan-subtitle">{pricingData.mainPlan.description}</p>
          </div>
          
          <div class="scope-pill">
            <strong>{pricingData.mainPlan.price}</strong>
            <span>{pricingData.mainPlan.deliveryTime}</span>
          </div>

          <a class="button button--acid" href="/contact/">
            <span>{pricingData.mainPlan.ctaText}</span>
            <i>→</i>
          </a>
        </div>

        <div class="price-card__includes">
          <h3>{pricingData.mainPlan.includedTitle}</h3>
          <ul>
            {pricingData.mainPlan.features.map((feature) => (
              <li>
                <b>✓</b>{feature}
              </li>
            ))}
          </ul>
        </div>
      </article>

      <!-- Side Grid -->
      <div class="pricing__side">
        <!-- Addon Card -->
        <article class="price-card price-card--addon" data-reveal>
          <span class="label">{pricingData.addonPlan.tag}</span>
          <h3>{pricingData.addonPlan.title}</h3>
          <p>{pricingData.addonPlan.subtitle}</p>
          <div class="addon-rate">
            <strong>{pricingData.addonPlan.price}</strong>
            <small>{pricingData.addonPlan.period}</small>
          </div>
          <ul>
            {pricingData.addonPlan.features.map((feature) => (
              <li>
                <b>✓</b>{feature}
              </li>
            ))}
          </ul>
        </article>

        <!-- Pricing Note -->
        <article class="pricing-note" data-reveal>
          <b>✦</b>
          <p>{pricingData.customScope.description}</p>
        </article>
      </div>

      <!-- Featured App Card -->
      <article class="price-card price-card--work" data-reveal>
        <span class="label">● LIVE PRODUCTION</span>
        <div class="plan-header">
          <h3>Mulya Lestari</h3>
          <p class="plan-subtitle">Sistem Informasi Manajemen Bengkel Mobil Multi-Cabang</p>
        </div>

        <div class="featured-work-thumb">
          <img src="https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?auto=format&fit=crop&w=800&q=80" alt="Mulya Lestari Preview" loading="lazy" />
        </div>

        <ul class="featured-work-specs">
          <li><b>✓</b>Pencatatan Servis &amp; Kasir Real-Time</li>
          <li><b>✓</b>Monitoring Stok &amp; Multi-Cabang</li>
          <li><b>✓</b>Next.js · TailwindCSS · PostgreSQL</li>
        </ul>

        <div class="featured-work-btns">
          <a class="button button--acid" href="/work/mulya-lestari/">
            <span>Lihat Studi Kasus</span>
            <i>→</i>
          </a>
          <a class="featured-live-link" href="https://mulyalestari.my.id/" target="_blank" rel="noopener noreferrer">
            Buka Live App ↗
          </a>
        </div>
      </article>

    </div>

  </div>
</section>

<style>
  .plan-header {
    margin-top: 0.75rem;
  }
  .plan-header h3 {
    font-size: 1.45rem;
    font-weight: 850;
    line-height: 1.15;
    color: var(--paper);
  }
  .plan-subtitle {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: #b2b2aa;
  }
  .scope-pill {
    margin: 1.15rem 0 1.25rem;
    padding: 0.65rem 0.9rem;
    background: #272724;
    border: 1px solid #44443e;
    border-radius: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .scope-pill strong {
    color: var(--acid);
    font-size: 1.05rem;
    font-weight: 800;
  }
  .scope-pill span {
    color: #c4c4bc;
    font-size: 0.74rem;
  }
  .price-card__offer > .button {
    width: 100%;
  }
  .addon-rate {
    margin: 0.6rem 0 0.8rem;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .addon-rate strong {
    font-size: 1.25rem;
    font-weight: 800;
  }
  .addon-rate small {
    font-size: 0.76rem;
    opacity: 0.8;
  }
  .pricing-note b {
    font-size: 1.1rem;
    line-height: 1;
  }
  .featured-work-thumb {
    margin: 1rem 0;
    border-radius: 0.6rem;
    overflow: hidden;
    height: 120px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .featured-work-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .featured-work-specs {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: #d4d4cb;
  }
  .featured-work-specs li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .featured-work-specs b {
    color: var(--acid);
  }
  .featured-work-btns {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .featured-work-btns .button {
    width: 100%;
    justify-content: center;
    font-size: 0.85rem;
    padding: 0.65rem 1rem;
  }
  .featured-live-link {
    text-align: center;
    color: var(--acid);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: underline;
    opacity: 0.9;
    transition: opacity 0.2s;
  }
  .featured-live-link:hover {
    opacity: 1;
  }
</style>
