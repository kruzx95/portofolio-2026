---
import { footerData } from '../data/content';
import { resolvePath } from '../utils/paths';
---

<footer class="footer" data-dark-section>
  <div class="container">
    
    <div class="footer__brand">
      <a href={resolvePath("/")}>
        <span>Mallik</span><strong>Dev</strong>
      </a>
      <p>{footerData.readyTag}</p>
    </div>

    <div class="footer__cta">
      <p>{footerData.tagline}</p>
      <a href={resolvePath("/contact/")}>
        Konsultasi Sekarang<span>→</span>
      </a>
    </div>

    <div class="footer__bottom">
      <p>
        {footerData.copyright}
        <small>{footerData.madeWith}</small>
      </p>

      <div class="footer__columns">
        <div>
          <b>Navigasi</b>
          <a href={resolvePath("/#process")}>Alur Kerja</a>
          <a href={resolvePath("/#pricing")}>Skema Biaya</a>
          <a href={resolvePath("/#work")}>Portofolio</a>
          <a href={resolvePath("/#why-us")}>Keunggulan</a>
          <a href={resolvePath("/contact/")}>Kontak &amp; Konsultasi</a>
        </div>

        <div>
          <b>Hubungi</b>
          <a href="mailto:kruza8@gmail.com?subject=Konsultasi%20Pembuatan%20Aplikasi">kruza8@gmail.com</a>
          <a href="https://mail.google.com/mail/?view=cm&fs=1&to=kruza8@gmail.com&su=Konsultasi%20Pembuatan%20Aplikasi" target="_blank" rel="noopener">Buka via Gmail Web ↗</a>
          <a href="https://github.com" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>

      <div class="footer__legal">
        <a href={resolvePath("/privacy/")}>Kebijakan Privasi</a>
        <a href={resolvePath("/terms/")}>Syarat &amp; Ketentuan</a>
        <a href="mailto:kruza8@gmail.com">kruza8@gmail.com</a>
      </div>
    </div>

  </div>
</footer>
