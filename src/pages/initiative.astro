---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Initiative — Project Go">
  <Navbar />
  <main id="main" class="initiative-page">
    <section class="initiative-hero">
      <div class="container initiative-hero__grid">
        <div data-reveal>
          <p class="eyebrow">A practical promise</p>
          <h1>
            <span>Good work should</span>
            <span>move further.</span>
          </h1>
        </div>
        <p data-reveal>Every completed Project Go launch funds one full day of practical skills training through an independent community partner.</p>
      </div>

      <div class="container initiative-hero__images">
        <figure data-reveal class="initiative-image--1">
          <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=700&h=800&q=86" alt="Community volunteers working together" data-parallax="6" />
        </figure>
        <figure data-reveal class="initiative-image--2">
          <img src="https://images.unsplash.com/photo-1559027615-cd4628902d4a?auto=format&fit=crop&w=700&h=800&q=86" alt="Community workshop participants smiling" data-parallax="3" />
        </figure>
        <figure data-reveal class="initiative-image--3">
          <img src="https://images.unsplash.com/photo-1593113598332-cd288d649433?auto=format&fit=crop&w=700&h=800&q=86" alt="Volunteers preparing materials" data-parallax="6" />
        </figure>
      </div>
    </section>

    <section class="initiative-story">
      <div class="container initiative-story__grid">
        <p class="eyebrow" data-reveal>Why it exists</p>
        <div data-reveal>
          <p>A stronger website can create momentum for one business. We wanted each launch to carry a little of that momentum beyond the project itself.</p>
          <p>Our contribution supports small, focused workshops built around useful digital skills, clearer communication, and the confidence to turn existing knowledge into independent work.</p>
        </div>
      </div>
    </section>

    <section class="initiative-principles">
      <div class="container">
        <div class="initiative-principles__head" data-reveal>
          <p class="eyebrow">How the promise works</p>
          <h2>Small enough to be real. Clear enough to repeat.</h2>
        </div>
        <div class="initiative-principles__grid">
          <article class="accent" data-reveal>
            <span>01</span>
            <h3>One launch, one day</h3>
            <p>The contribution is tied to completed work, making the commitment simple, visible, and repeatable.</p>
          </article>
          <article data-reveal>
            <span>02</span>
            <h3>Skills over slogans</h3>
            <p>Support goes toward practical sessions people can use immediately—not vague awareness campaigns.</p>
          </article>
          <article class="accent" data-reveal>
            <span>03</span>
            <h3>Progress reported</h3>
            <p>The partner shares what ran, who participated, and what the next round of support will make possible.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="initiative-closing" data-dark-section>
      <div class="container" data-reveal>
        <p class="eyebrow">Start something useful</p>
        <h2>Build something useful for your business—and help someone else build what comes next.</h2>
        <a href="/contact/">
          <span>Start a project</span>
          <i>→</i>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
