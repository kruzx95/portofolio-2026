---
import { heroData, siteMeta } from '../data/content';
---

<section class="hero" data-hero>
  <div class="hero__wash" aria-hidden="true"></div>
  
  <div class="hero__content" data-hero-copy>
    <p class="hero__badge">{heroData.badge}</p>
    <p class="eyebrow">{heroData.subheading}</p>
    <h1>Bikin Aplikasi<br/>Cepat &amp; Skalabel.</h1>
    <p class="hero__body" data-split>{heroData.description}</p>
    
    <div class="hero__actions">
      <a class="button button--acid" href="/contact/">
        <span>Konsultasi Aplikasi</span>
        <i>→</i>
      </a>
      <a class="button button--dark" href="/#pricing">
        <span>Lihat Paket &amp; Biaya</span>
        <i>→</i>
      </a>
    </div>

    <p class="hero__guarantee">
      <b>✓</b>{siteMeta.satisfactionGuarantee}
    </p>
  </div>

  <div class="hero__cards" aria-hidden="true">
    {heroData.floatingCards.map((card, idx) => (
      <article class={`hero-card ${card.cardClass}`} data-hero-card data-index={idx}>
        <img
          src={card.image}
          onerror={`this.onerror=null;this.src='${card.fallbackImage}'`}
          alt={card.title}
          loading="eager"
        />
        <strong>{card.title}</strong>
      </article>
    ))}

    <p class="hero__note">
      {heroData.annotationQuote}
      <svg aria-hidden="true" viewBox="0 0 150 86" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 12C42 11 66 20 87 36C103 48 116 61 137 67"></path>
        <path d="M124 57L138 68L122 73"></path>
      </svg>
    </p>
  </div>
</section>

<style>
  .hero h1 {
    max-width: 15ch;
    text-wrap: balance;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
</style>

<script>
  // Animate hero cards into view smoothly
  const heroCards = document.querySelectorAll<HTMLElement>('[data-hero-card]');
  if (heroCards.length > 0) {
    setTimeout(() => {
      heroCards.forEach((card, idx) => {
        setTimeout(() => {
          card.style.opacity = '1';
          card.style.transform = `rotate(var(--end-r, 0deg)) scale(1)`;
          card.style.transition = 'transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease';
        }, idx * 100);
      });
    }, 150);
  }
</script>
