---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import ValueProp from '../components/ValueProp.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import Pricing from '../components/Pricing.astro';
import Showcase from '../components/Showcase.astro';
import Comparison from '../components/Comparison.astro';
import StatsTrust from '../components/StatsTrust.astro';
import Team from '../components/Team.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import ImpactBanner from '../components/ImpactBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main id="main">
    <Hero />
    <PainPoints />
    <ValueProp />
    <ProcessFlow />
    <MarqueeTicker />
    <Pricing />
    <Showcase />
    <Comparison />
    <StatsTrust />
    <Team />
    <Testimonials />
    <Faq />
    <ImpactBanner />
    <ContactForm />
  </main>
  <Footer />
</Layout>
