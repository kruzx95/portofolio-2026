---
import { impactData } from '../data/content';
---

<section class="impact-section" id="consultation">
  <div class="container">
    <div class="impact-card" data-reveal>
      <div class="impact-card__content">
        <span class="impact-badge">✦ {impactData.badge}</span>
        <h2>{impactData.headline}</h2>
        <p>{impactData.description}</p>
      </div>

      <div class="impact-card__action">
        <a class="button button--dark" href={impactData.ctaLink}>
          <span>{impactData.ctaText}</span>
          <i>→</i>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .impact-section {
    padding: 3.5rem 0 4.5rem;
    background: transparent;
  }

  .impact-card {
    background: var(--acid);
    border: 2px solid var(--ink);
    border-radius: 1.25rem;
    box-shadow: 5px 6px 0 var(--ink);
    padding: 2.75rem 3.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 3rem;
  }

  .impact-badge {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.3rem 0.75rem;
    border-radius: 0.35rem;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .impact-card h2 {
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 850;
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.03em;
  }

  .impact-card p {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #2b2b27;
    max-width: 58ch;
    margin: 0;
  }

  .impact-card__action {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .impact-card__action .button {
    white-space: nowrap;
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
    border: 2px solid var(--ink);
    min-height: 3.2rem;
  }

  .impact-card__action .button:hover {
    transform: translate(2px, 2px);
  }

  .impact-card__action .button i {
    background: var(--paper);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .impact-card {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      gap: 1.75rem;
    }
    .impact-card__action {
      justify-content: flex-start;
    }
    .impact-card__action .button {
      width: 100%;
    }
  }
</style>
