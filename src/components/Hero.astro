---
import { heroData, siteMeta } from '../data/content';
---

<section class="hero" data-hero>
  <div class="hero__wash" aria-hidden="true"></div>
  
  <div class="hero__content" data-hero-copy>
    <p class="hero__badge">{heroData.badge}</p>
    <p class="eyebrow">{heroData.subheading}</p>
    <h1>Your next launch, handled.</h1>
    <p class="hero__body" data-split>{heroData.description}</p>
    
    <div class="hero__actions">
      <a class="button button--acid" href="/contact/">
        <span>Start your project</span>
        <i>→</i>
      </a>
      <a class="button button--dark" href="/#pricing">
        <span>View pricing</span>
        <i>→</i>
      </a>
    </div>

    <p class="hero__guarantee">
      <b>✓</b>{siteMeta.satisfactionGuarantee}
    </p>
  </div>

  <div class="hero__cards" aria-hidden="true">
    <article class="hero-card card--one" data-hero-card data-index="0">
      <img src="https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?auto=format&fit=crop&w=720&h=560&q=86" alt="Creative workspace with design materials" />
      <strong>North House</strong>
    </article>

    <article class="hero-card card--two" data-hero-card data-index="1">
      <img src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=720&h=560&q=86" alt="Creative team collaborating in a studio" />
      <strong>Kinfolk Studio</strong>
    </article>

    <article class="hero-card card--three" data-hero-card data-index="2">
      <img src="https://images.unsplash.com/photo-1523726491678-bf852e717f6a?auto=format&fit=crop&w=720&h=560&q=86" alt="Designer working on a digital interface" />
      <strong>Sunday Goods</strong>
    </article>

    <article class="hero-card card--four" data-hero-card data-index="3">
      <img src="https://images.unsplash.com/photo-1558655146-9f40138edfeb?auto=format&fit=crop&w=720&h=560&q=86" alt="Brand and interface design on a screen" />
      <strong>Field Office</strong>
    </article>

    <article class="hero-card card--five" data-hero-card data-index="4">
      <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=720&h=560&q=86" alt="Consultant presenting ideas in a meeting" />
      <strong>Cedar &amp; Co.</strong>
    </article>

    <p class="hero__note">
      {heroData.annotationQuote}
      <svg aria-hidden="true" viewBox="0 0 150 86" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 12C42 11 66 20 87 36C103 48 116 61 137 67"></path>
        <path d="M124 57L138 68L122 73"></path>
      </svg>
    </p>
  </div>
</section>

<script>
  // Animate hero cards into view smoothly
  const heroCards = document.querySelectorAll<HTMLElement>('[data-hero-card]');
  if (heroCards.length > 0) {
    setTimeout(() => {
      heroCards.forEach((card, idx) => {
        setTimeout(() => {
          card.style.opacity = '1';
          card.style.transform = `rotate(var(--end-r, 0deg)) scale(1)`;
          card.style.transition = 'transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease';
        }, idx * 100);
      });
    }, 150);
  }
</script>
