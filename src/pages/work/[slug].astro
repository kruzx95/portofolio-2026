---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'north-house' },
      props: {
        name: 'North House',
        services: 'Positioning · Copywriting · Art direction · Astro development',
        tagline: 'A warmer, clearer digital home for an independent architecture practice built around thoughtful collaboration.',
        heroImage: 'https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1600&h=1100&q=86',
        storyP1: 'North House had the work, reputation, and referrals—but its old website made the practice feel more distant than the team really was.',
        storyP2: 'We rebuilt the story around a simple idea: rigorous architecture can still feel personal. The new site gives projects room to breathe while making the studio’s process easy to understand.',
        metric: '2.4×',
        metricLabel: 'more qualified enquiries',
        gallery1: 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1500&h=1000&q=86',
        gallery2: 'https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1500&h=1000&q=86',
        nextSlug: 'field-office',
        nextName: 'Field Office',
        nextImage: 'https://images.unsplash.com/photo-1523726491678-bf852e717f6a?auto=format&fit=crop&w=1600&h=1100&q=86'
      }
    },
    {
      params: { slug: 'field-office' },
      props: {
        name: 'Field Office',
        services: 'Brand Identity · Digital Strategy · UI/UX Design · Astro Build',
        tagline: 'Modernizing a specialized environmental consulting firm to win enterprise advisory projects.',
        heroImage: 'https://images.unsplash.com/photo-1523726491678-bf852e717f6a?auto=format&fit=crop&w=1600&h=1100&q=86',
        storyP1: 'Field Office delivered world-class ecological analysis but struggled to communicate its complex scientific methodology to corporate decision makers.',
        storyP2: 'We crafted structured case studies and an interactive data visualization module that clearly showcase impact and regulatory compliance.',
        metric: '3.1×',
        metricLabel: 'longer average session duration',
        gallery1: 'https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&w=1500&h=1000&q=86',
        gallery2: 'https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=1500&h=1000&q=86',
        nextSlug: 'sunday-goods',
        nextName: 'Sunday Goods',
        nextImage: 'https://images.unsplash.com/photo-1558655146-9f40138edfeb?auto=format&fit=crop&w=1600&h=1100&q=86'
      }
    },
    {
      params: { slug: 'sunday-goods' },
      props: {
        name: 'Sunday Goods',
        services: 'E-Commerce · Visual Identity · Custom Product Filtering',
        tagline: 'An elegant lifestyle goods storefront engineered for high conversion and effortless catalog updates.',
        heroImage: 'https://images.unsplash.com/photo-1558655146-9f40138edfeb?auto=format&fit=crop&w=1600&h=1100&q=86',
        storyP1: 'Sunday Goods needed a digital experience as refined as their handcrafted homewares, moving away from slow generic marketplace templates.',
        storyP2: 'We delivered an Astro-powered static storefront that loads in under 300ms, driving immediate cart conversions.',
        metric: '48%',
        metricLabel: 'boost in checkout completion',
        gallery1: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1500&h=1000&q=86',
        gallery2: 'https://images.unsplash.com/photo-1507089947368-19c1da9775ae?auto=format&fit=crop&w=1500&h=1000&q=86',
        nextSlug: 'cedar-and-co',
        nextName: 'Cedar & Co.',
        nextImage: 'https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=1600&h=1100&q=86'
      }
    },
    {
      params: { slug: 'cedar-and-co' },
      props: {
        name: 'Cedar & Co.',
        services: 'Executive Positioning · Web Strategy · Lead Generation',
        tagline: 'Transforming a boutique management advisory firm into a recognized industry authority.',
        heroImage: 'https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=1600&h=1100&q=86',
        storyP1: 'Cedar & Co. had high referral volume but needed a polished corporate digital footprint to validate multimillion-dollar retainers.',
        storyP2: 'We created an editorial-first publication layout featuring their proprietary framework and founder commentary.',
        metric: '92%',
        metricLabel: 'of leads cited site clarity',
        gallery1: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1500&h=1000&q=86',
        gallery2: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1500&h=1000&q=86',
        nextSlug: 'gather-journal',
        nextName: 'Gather Journal',
        nextImage: 'https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&w=1600&h=1100&q=86'
      }
    },
    {
      params: { slug: 'gather-journal' },
      props: {
        name: 'Gather Journal',
        services: 'Editorial Layout · Digital Magazine · Subscription Flow',
        tagline: 'A bespoke digital home for an award-winning independent publication.',
        heroImage: 'https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&w=1600&h=1100&q=86',
