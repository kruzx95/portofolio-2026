---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Privacy Policy — Project Go">
  <Navbar />
  <main class="section section-light">
    <div class="container container-narrow legal-content">
      <h1 class="h2-title">Privacy Policy</h1>
      <p class="legal-date">Last updated: August 20, 2026</p>
      
      <div class="legal-body">
        <h2>1. Information We Collect</h2>
        <p>When you contact us or request a launch quote through our website, we may collect your name, email address, company name, project details, and timeline expectations.</p>

        <h2>2. How We Use Your Information</h2>
        <p>We use the collected information solely to communicate with you about your project, provide estimates, and deliver our web design and development services.</p>

        <h2>3. Data Protection</h2>
        <p>We implement security measures to maintain the safety of your personal information. We do not sell, trade, or otherwise transfer your information to outside parties.</p>

        <h2>4. Contact Us</h2>
        <p>If you have any questions regarding this privacy policy, please contact us at <a href="mailto:hello@projectgo.com" class="text-link">hello@projectgo.com</a>.</p>
      </div>

      <div class="legal-back-wrap">
        <a href="/" class="btn btn-dark">← Back to Home</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal-content {
    padding: 3rem 0 5rem;
  }
  .legal-date {
    font-size: 0.85rem;
    color: var(--text-light-muted);
    margin-bottom: 2rem;
  }
  .legal-body h2 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 1.5rem 0 0.5rem;
    color: #0D0D0D;
  }
  .legal-body p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-light-secondary);
    margin-bottom: 1rem;
  }
  .text-link {
    color: #0D0D0D;
    font-weight: 700;
    text-decoration: underline;
  }
  .legal-back-wrap {
    margin-top: 3rem;
  }
</style>
