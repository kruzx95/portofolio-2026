---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'motion-with-a-job' },
      props: {
        title: 'Motion should have a job',
        category: 'Motion',
        date: 'Jun 18, 2026',
        readTime: '6 min',
        image: 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1600&h=1000&q=86',
        intro: 'A practical framework for deciding when movement adds meaning—and when it simply adds noise.',
        content: [
          'Movement on the web works best when it explains a relationship rather than demanding applause. When an interface element changes position, the animation should clarify where it came from, where it went, and what just happened.',
          'Before adding a scroll effect, parallax layer, or entrance transition, we ask three simple questions: Does this communicate hierarchy? Does this reduce friction? Would removing it make the page harder to understand?',
          'If the answer to all three is no, the movement is decorative decoration that will likely feel tedious by the third visit. Keep motion purposeful, brisk, and respectful of reduced motion preferences.'
        ]
      }
    },
    {
      params: { slug: 'briefs-that-leave-room' },
      props: {
        title: 'Write a brief that leaves room',
        category: 'Process',
        date: 'May 2, 2026',
        readTime: '5 min',
        image: 'https://images.unsplash.com/photo-1456324504439-367cee3b3c32?auto=format&fit=crop&w=1600&h=1000&q=86',
        intro: 'The best creative briefs create useful constraints without deciding the answer in advance.',
        content: [
          'A common mistake in client briefs is confusing a list of features with a definition of the problem. When a brief prescribes exact layouts and button placements, it misses the opportunity for creative problem solving.',
          'Instead, focus on defining the audience, the true objection you need to overcome, and what success looks like in 6 months.',
          'Constraints set direction; room to explore unlocks the best work.'
        ]
      }
    },
    {
      params: { slug: 'designing-for-editors' },
      props: {
        title: 'Design the CMS for the editor',
        category: 'Development',
        date: 'Mar 21, 2026',
        readTime: '7 min',
        image: 'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1600&h=1000&q=86',
        intro: 'A flexible website is only useful when the people running it understand what the system is asking them to do.',
        content: [
          'A website that requires a developer for every typo fix is a broken product. But a CMS that offers 80 configurable settings per block quickly becomes overwhelming.',
          'The solution is thoughtful curation. Give editors structured, predictable fields that make it impossible to break the typography or brand layout.',
          'When updating a page feels effortless, the website stays fresh and relevant.'
        ]
      }
    }
  ];
}

const { title, category, date, readTime, image, intro, content } = Astro.props;
---

<Layout title={`${title} — Project Go Blog`}>
  <Navbar />
  <main id="main" class="article-page">
    <article class="container container-narrow">
      <header class="article-header" style="padding-top: 8rem; margin-bottom: 3rem;">
        <a href="/blog/" class="eyebrow" style="display: inline-block; margin-bottom: 1.5rem;">← Back to blog</a>
        <p class="eyebrow">{category} · {date} · {readTime}</p>
        <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 850; letter-spacing: -0.04em; line-height: 1.05; margin: 1rem 0 1.5rem;">{title}</h1>
        <p style="font-size: 1.25rem; font-weight: 600; line-height: 1.5; color: var(--muted);">{intro}</p>
      </header>

      <figure style="margin-bottom: 3.5rem; border: 2px solid var(--ink); border-radius: 1rem; overflow: hidden; box-shadow: 4px 5px 0 var(--ink);">
        <img src={image} alt={title} style="width: 100%; height: auto; object-fit: cover;" />
      </figure>

      <div class="rich-text" style="margin-bottom: 5rem;">
        {content.map((p: string) => (
          <p style="font-size: 1.15rem; line-height: 1.7; margin-bottom: 1.5rem;">{p}</p>
        ))}
      </div>

      <div style="border-top: 1px solid var(--dark-line); padding: 3rem 0; display: flex; justify-content: space-between; align-items: center;">
        <a href="/blog/" class="button button--dark">
          <span>← Back to all posts</span>
        </a>
        <a href="/contact/" class="button button--acid">
          <span>Start your project</span>
          <i>→</i>
        </a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
