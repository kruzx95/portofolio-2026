---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms of Service — Project Go">
  <Navbar />
  <main class="section section-light">
    <div class="container container-narrow legal-content">
      <h1 class="h2-title">Terms of Service</h1>
      <p class="legal-date">Last updated: August 20, 2026</p>
      
      <div class="legal-body">
        <h2>1. Scope of Services</h2>
        <p>Project Go provides website strategy, copywriting, visual design, custom Astro development, and launch QA support under agreed project timelines and scopes.</p>

        <h2>2. Ownership & Intellectual Property</h2>
        <p>Upon full payment of project fees, the client owns 100% of the custom design assets, copy, and source code generated specifically for their website.</p>

        <h2>3. Timelines & Client Feedback</h2>
        <p>Our 4–6 week launch commitments rely on timely consolidated feedback according to the agreed milestone schedule.</p>

        <h2>4. Contact</h2>
        <p>For any questions regarding these terms, please contact <a href="mailto:hello@projectgo.com" class="text-link">hello@projectgo.com</a>.</p>
      </div>

      <div class="legal-back-wrap">
        <a href="/" class="btn btn-dark">← Back to Home</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal-content {
    padding: 3rem 0 5rem;
  }
  .legal-date {
    font-size: 0.85rem;
    color: var(--text-light-muted);
    margin-bottom: 2rem;
  }
  .legal-body h2 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 1.5rem 0 0.5rem;
    color: #0D0D0D;
  }
  .legal-body p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-light-secondary);
    margin-bottom: 1rem;
  }
  .text-link {
    color: #0D0D0D;
    font-weight: 700;
    text-decoration: underline;
  }
  .legal-back-wrap {
    margin-top: 3rem;
  }
</style>
