---
import { painPointsData } from '../data/content';

const tasks = [
  "Rancang arsitektur database",
  "Desain UI/UX interaktif",
  "Integrasi API & payment gateway",
  "Setup autentikasi & keamanan",
  "Pengembangan frontend & backend",
  "Optimasi performa & query",
  "Setup server cloud & domain",
  "Konfigurasi SSL & proteksi data",
  "Testing lintas browser & mobile",
  "Admin dashboard terintegrasi",
  "Uji performa & beban sistem",
  "Garansi bug fixing 30 hari",
  "Dokumentasi & panduan serah terima lengkap",
  "Monitoring error & analitik",
  "Dukungan rilis ke publik",
  "Pemeliharaan berkala"
];

const thoughts = [
  { text: "Developer sebelumnya menghilang di tengah jalan", class: "thought--1" },
  { text: "Takut kodenya berantakan & sulit di-scale", class: "thought--2" },
  { text: "Mau bikin MVP tapi bingung mulai dari mana?", class: "thought--3" },
  { text: "Butuh timeline pengerjaan yang pasti & transparan", class: "thought--4" },
  { text: "Aplikasi sebelumnya lambat & sering error", class: "thought--5" },
  { text: "Takut biaya membengkak karena biaya tak terduga", class: "thought--6" }
];
---

<section class="overwhelm section-pad" data-dark-section>
  <div class="container overwhelm__panel" data-reveal>
    
    <div class="overwhelm__ticker" aria-hidden="true">
      <div class="overwhelm__track">
        <div class="overwhelm__group" aria-hidden="false">
          {tasks.map((task) => (
            <div class="task">
              <span>□</span>
              <p>{task}</p>
              <i>•••</i>
            </div>
          ))}
        </div>
        <div class="overwhelm__group" aria-hidden="true">
          {tasks.map((task) => (
            <div class="task">
              <span>□</span>
              <p>{task}</p>
              <i>•••</i>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="overwhelm__copy">
      <p class="eyebrow">{painPointsData.subheading}</p>
      <h2>Aplikasi Anda.<br/>Tanpa Kerumitan.</h2>
    </div>

    <div class="thoughts" aria-hidden="true">
      {thoughts.map((t) => (
        <b class={`thought ${t.class}`} data-thought>{t.text}</b>
      ))}
    </div>

  </div>
</section>

<script>
  // Animate thought bubbles when scrolled into view
  const thoughtElms = document.querySelectorAll<HTMLElement>('[data-thought]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        thoughtElms.forEach((t, i) => {
          setTimeout(() => {
            t.style.opacity = '1';
            t.style.transform = 'translateY(0) rotate(var(--r, 0deg)) scale(1)';
            t.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease';
          }, i * 150);
        });
        observer.disconnect();
      }
    });
  }, { threshold: 0.2 });

  const panel = document.querySelector('.overwhelm__panel');
  if (panel) observer.observe(panel);
</script>
