---
import { comparisonData } from '../data/content';
---

<section class="comparison section-pad" id="why-us">
  <div class="container">
    
    <div class="section-head centered" data-reveal>
      <p class="eyebrow">{comparisonData.badge}</p>
      <h2>{comparisonData.headline}</h2>
      <p>{comparisonData.description}</p>
    </div>

    <div class="values-grid" data-reveal>
      {comparisonData.pillars.map((pillar) => (
        <article class="value-card">
          <div class="value-card__top">
            <span class="value-card__num">{pillar.num}</span>
            <span class="value-card__tag">✦</span>
          </div>
          <h3>{pillar.title}</h3>
          <p>{pillar.description}</p>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 1080px;
    margin: 3.5rem auto 0;
  }

  .value-card {
    background: #efefe8;
    border: 2px solid var(--ink);
    border-radius: 0.9rem;
    box-shadow: 4px 5px 0 var(--ink);
    padding: 2.2rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s;
  }

  .value-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 7px 0 var(--ink);
  }

  .value-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .value-card__num {
    background: var(--ink);
    color: var(--acid);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 0.35rem;
    letter-spacing: 0.05em;
  }

  .value-card__tag {
    color: var(--ink);
    font-size: 0.9rem;
    opacity: 0.4;
  }

  .value-card h3 {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }

  .value-card p {
    font-size: 0.94rem;
    line-height: 1.55;
    color: #383834;
  }

  @media (max-width: 760px) {
    .values-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 2.5rem;
    }
    .value-card {
      padding: 1.5rem;
    }
    .value-card h3 {
      font-size: 1.2rem;
    }
  }
</style>
