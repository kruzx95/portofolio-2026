---
import { painPointsData } from '../data/content';

const tasks = [
  "Clarify the offer",
  "Write every page",
  "Design the layouts",
  "Fix spacing and alignment",
  "Build responsive components",
  "Configure the CMS",
  "Compress every image",
  "Connect analytics",
  "Add search metadata",
  "Test forms and integrations",
  "Check every browser",
  "Connect the domain",
  "Set up redirects",
  "Build a useful 404",
  "Review mobile layouts",
  "Run launch QA"
];

const thoughts = [
  { text: "I don’t have time for this", class: "thought--1" },
  { text: "Why can’t I edit it myself?", class: "thought--2" },
  { text: "Will this actually bring in clients?", class: "thought--3" },
  { text: "The last team disappeared", class: "thought--4" },
  { text: "It looked fine until I opened it on my phone", class: "thought--5" },
  { text: "I’ve been burned before", class: "thought--6" }
];
---

<section class="overwhelm section-pad" data-dark-section>
  <div class="container overwhelm__panel" data-reveal>
    
    <div class="overwhelm__ticker" aria-hidden="true">
      <div class="overwhelm__track">
        <div class="overwhelm__group" aria-hidden="false">
          {tasks.map((task) => (
            <div class="task">
              <span>□</span>
              <p>{task}</p>
              <i>•••</i>
            </div>
          ))}
        </div>
        <div class="overwhelm__group" aria-hidden="true">
          {tasks.map((task) => (
            <div class="task">
              <span>□</span>
              <p>{task}</p>
              <i>•••</i>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="overwhelm__copy">
      <p class="eyebrow">{painPointsData.subheading}</p>
      <h2>Your website. Less work.</h2>
    </div>

    <div class="thoughts" aria-hidden="true">
      {thoughts.map((t) => (
        <b class={`thought ${t.class}`} data-thought>{t.text}</b>
      ))}
    </div>

  </div>
</section>

<script>
  // Animate thought bubbles when scrolled into view
  const thoughtElms = document.querySelectorAll<HTMLElement>('[data-thought]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        thoughtElms.forEach((t, i) => {
          setTimeout(() => {
            t.style.opacity = '1';
            t.style.transform = 'translateY(0) rotate(var(--r, 0deg)) scale(1)';
            t.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease';
          }, i * 150);
        });
        observer.disconnect();
      }
    });
  }, { threshold: 0.2 });

  const panel = document.querySelector('.overwhelm__panel');
  if (panel) observer.observe(panel);
</script>
